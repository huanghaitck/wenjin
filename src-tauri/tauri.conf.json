{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "问津",
  "version": "0.1.0",
  "identifier": "cn.hrw.historical-research-workbench",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "问津｜人文社会科学研究工作台",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/hrw-sidecar"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

# M4 main reasoning role. Providers: openai_compatible or ollama.
# The deterministic mock is built in and needs no environment variables.
# Never commit real keys.
HRW_AGENT_PROVIDER=
HRW_AGENT_BASE_URL=
HRW_AGENT_MODEL=
HRW_AGENT_API_KEY=
HRW_AGENT_TIMEOUT_SECONDS=90

HRW_VISION_PROVIDER=mock
HRW_VISION_BASE_URL=
HRW_VISION_MODEL=mock-vision
HRW_VISION_API_KEY=

# M3 visual OCR role. Providers: openai_compatible, ollama, or mock (tests only).
# The visual model code includes the required "v".
HRW_OCR_PROVIDER=disabled
HRW_OCR_BASE_URL=
HRW_OCR_MODEL=
HRW_OCR_API_KEY=
HRW_OCR_TIMEOUT_SECONDS=90
# Suggested first remote benchmark: glm-4.6v-flash
# Suggested local comparator: ollama/qwen3-vl:4b-instruct-q4_K_M

HRW_TRANSLATION_PROVIDER=mock
HRW_TRANSLATION_BASE_URL=
HRW_TRANSLATION_MODEL=mock-translation
HRW_TRANSLATION_API_KEY=

# Future local example; no key is required for local Ollama.
HRW_OLLAMA_BASE_URL=http://127.0.0.1:11434
